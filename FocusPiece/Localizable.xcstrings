    "Camille Monet auf einer Anhöhe, der Stoff im Sommerwind, das Gras voller Licht. Ein Augenblick, festgehalten in wenigen Minuten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Camille Monet auf einer Anhöhe, der Stoff im Sommerwind, das Gras voller Licht. Ein Augenblick, festgehalten in wenigen Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camille Monet on a rise, her dress in the summer wind, the grass full of light. A moment caught in a matter of minutes."
          }
        }
      }
    },
    "Darstellung": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        }
      }
    },
    "Das Bild konnte nicht gesichert werden.": {
      "localizations": {
        "de": {
