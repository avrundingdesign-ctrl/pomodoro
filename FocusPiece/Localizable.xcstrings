    "Drei Gestalten auf einem Felsen, Segel in der Dämmerung, der Mond hinter Wolken. Sehnsucht, in Farbe gefasst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Gestalten auf einem Felsen, Segel in der Dämmerung, der Mond hinter Wolken. Sehnsucht, in Farbe gefasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three figures on a rock, sails in the dusk, the moon behind cloud. Longing, set down in colour."
          }
        }
      }
    },
    "Drei ruhige Schritte": {
      "localizations": {
        "de": {
