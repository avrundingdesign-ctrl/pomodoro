          "stringUnit": {
            "state": "translated",
            "value": "Hidden work"
          }
        }
      }
    },
    "Verlässt du die App, hält die Enthüllung sanft inne.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlässt du die App, hält die Enthüllung sanft inne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the app and the reveal gently pauses."
          }
        }
      }
    },
    "Vermeer und Rembrandt: vier Werke über Licht, Alltag und den Blick, der einen nicht mehr loslässt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeer und Rembrandt: vier Werke über Licht, Alltag und den Blick, der einen nicht mehr loslässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeer and Rembrandt: four works about light, everyday life, and a gaze that won't let go."
          }
        }
      }
    },
    "Vermeers Heimatstadt nach einem Regenschauer: Wolken, Wasser, aufblitzende Dächer. Für Proust „das schönste Bild der Welt“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeers Heimatstadt nach einem Regenschauer: Wolken, Wasser, aufblitzende Dächer. Für Proust „das schönste Bild der Welt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeer's home town after a shower: clouds, water, roofs catching the light. To Proust, “the most beautiful painting in the world”."
          }
        }
      }
    },
    "Vier Hauptwerke des Impressionismus: Gärten in Giverny, ein Sonntag auf dem Montmartre, Regen über Paris und ein Sommertag im Wind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Hauptwerke des Impressionismus: Gärten in Giverny, ein Sonntag auf dem Montmartre, Regen über Paris und ein Sommertag im Wind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four key works of Impressionism: the gardens at Giverny, a Sunday on Montmartre, rain over Paris and a summer day in the wind."
          }
        }
      }
    },
    "Vier Nächte der Kunstgeschichte: eine Caféterrasse unter Sternen, Mondlicht am Meer, Feuerwerk über dem Fluss und die Rhône im Sternenglanz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Nächte der Kunstgeschichte: eine Caféterrasse unter Sternen, Mondlicht am Meer, Feuerwerk über dem Fluss und die Rhône im Sternenglanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four nights in the history of art: a café terrace under the stars, moonlight on the sea, fireworks over the river, and the Rhône beneath a glitter of stars."
          }
        }
      }
    },
    "Vom Abendlicht bis zum Sternenhimmel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Abendlicht bis zum Sternenhimmel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From evening light to starry skies"
          }
        }
      }
    },
    "WERKINFO": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WERKINFO"
          }
        },
        "en": {
