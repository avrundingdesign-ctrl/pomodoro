            "state": "translated",
            "value": "WORK INFO"
          }
        }
      }
    },
    "Wasser, Licht und Blüten verschmelzen zu einer stillen Fläche ohne Horizont. Monets Garten in Giverny wurde sein größtes Motiv — und sein Lebenswerk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser, Licht und Blüten verschmelzen zu einer stillen Fläche ohne Horizont. Monets Garten in Giverny wurde sein größtes Motiv — und sein Lebenswerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water, light and blossom dissolve into a quiet surface without a horizon. Monet's garden at Giverny became his greatest subject — and his life's work."
          }
        }
      }
    },
