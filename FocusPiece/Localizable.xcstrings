    "Funken eines Feuerwerks fallen durch die Nacht über dem Themse-Ufer — Malerei an der Schwelle zur Abstraktion.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funken eines Feuerwerks fallen durch die Nacht über dem Themse-Ufer — Malerei an der Schwelle zur Abstraktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparks from a firework fall through the night above the Thames — painting on the threshold of abstraction."
          }
        }
      }
    },
