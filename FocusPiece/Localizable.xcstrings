        }
      }
    },
    "Gaslaternen spiegeln sich im Fluss, darüber der Große Wagen. Van Goghs erste große Sternennacht — ruhiger als ihre berühmte Schwester.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaslaternen spiegeln sich im Fluss, darüber der Große Wagen. Van Goghs erste große Sternennacht — ruhiger als ihre berühmte Schwester."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gas lamps reflected in the river, the Plough overhead. Van Gogh's first great starry night — quieter than its famous sister."
          }
        }
      }
    },
    "Gaslicht strahlt gelb in die blaue Nacht von Arles. Ein Nachthimmel voller Sterne — gemalt ganz ohne Schwarz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaslicht strahlt gelb in die blaue Nacht von Arles. Ein Nachthimmel voller Sterne — gemalt ganz ohne Schwarz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaslight glows yellow into the blue night of Arles. A sky full of stars — painted without using any black at all."
          }
        }
      }
    },
