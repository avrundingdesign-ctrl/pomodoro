    "Dein Werk bleibt verborgen — die Enthüllung geht verloren.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Werk bleibt verborgen — die Enthüllung geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your work stays hidden — the reveal will be lost."
          }
        }
      }
    },
    "Dein Werk ist vollständig enthüllt — komm zurück und betrachte es.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Werk ist vollständig enthüllt — komm zurück und betrachte es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your work is fully revealed — come back and take it in."
          }
        }
      }
    },
    "Deine Sets sind wieder Teil der Sammlung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sets sind wieder Teil der Sammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sets are part of the collection again."
          }
        }
      }
    },
    "Der Fuji glüht im Licht eines klaren Spätsommermorgens. Aus derselben Serie wie die große Welle — Stille statt Sturm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fuji glüht im Licht eines klaren Spätsommermorgens. Aus derselben Serie wie die große Welle — Stille statt Sturm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount Fuji glowing in the light of a clear late-summer morning. From the same series as the Great Wave — stillness instead of storm."
          }
        }
      }
    },
    "Der Hafen von Le Havre im Morgendunst. Das Bild, das der gesamten Bewegung des Impressionismus ihren Namen gab.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hafen von Le Havre im Morgendunst. Das Bild, das der gesamten Bewegung des Impressionismus ihren Namen gab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The harbour of Le Havre in the morning haze. The painting that gave the whole Impressionist movement its name."
          }
        }
      }
    },
    "Der Kauf konnte nicht abgeschlossen werden. Bitte versuch es später erneut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Bitte versuch es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn't be completed. Please try again later."
          }
        }
      }
    },
    "Der Kauf wartet auf eine Bestätigung (z. B. „Bitten, um zu kaufen“). Die Werke erscheinen automatisch, sobald er genehmigt ist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf eine Bestätigung (z. B. „Bitten, um zu kaufen“). Die Werke erscheinen automatisch, sobald er genehmigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is waiting for approval (for example “Ask to Buy”). The works will appear automatically once it goes through."
          }
        }
      }
    },
