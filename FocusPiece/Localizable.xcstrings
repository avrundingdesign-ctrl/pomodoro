    "Milch fließt, Brot liegt bereit, das Fensterlicht fällt still herein. Vermeer erhebt eine Alltagsgeste zur Andacht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Milch fließt, Brot liegt bereit, das Fensterlicht fällt still herein. Vermeer erhebt eine Alltagsgeste zur Andacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Milk pours, bread waits, and the light from the window falls quietly in. Vermeer raises an everyday gesture into devotion."
          }
        }
      }
    },
