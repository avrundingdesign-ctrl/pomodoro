        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell den Timer, bleib präsent — mit jeder fokussierten Minute tritt ein verborgenes Kunstwerk klarer hervor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the timer, stay present — with every focused minute a hidden work of art comes into view."
