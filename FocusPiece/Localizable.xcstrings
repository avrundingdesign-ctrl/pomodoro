    "Wirbelnde Sterne über einem ruhigen Dorf, gemalt aus der Erinnerung im Morgengrauen. Bewegung und Stille in einem einzigen Himmel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirbelnde Sterne über einem ruhigen Dorf, gemalt aus der Erinnerung im Morgengrauen. Bewegung und Stille in einem einzigen Himmel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swirling stars above a sleeping village, painted from memory at daybreak. Motion and stillness in a single sky."
          }
        }
      }
    },
