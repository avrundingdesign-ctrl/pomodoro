<!DOCTYPE html>
<html lang="de" data-server-now="<%= serverNow %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Straßenimperium</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="logo" href="/">🛒 Straßenimperium</a>
    <% if (locals.user) { %>
      <nav class="nav">
        <%
          const a = locals.active;
          const aktionen = [
            ["sammeln", "Sammeln", "/aktionen/sammeln"],
            ["betteln", "Betteln", "/aktionen/betteln"],
            ["verbrechen", "Verbrechen", "/aktionen/verbrechen"],
          ];
          const unread = locals.status ? status.unreadMessages : 0;
          const community = [
            ["highscore", "Highscore", "/highscore"],
            ["nachrichten", unread > 0 ? `Nachrichten (${unread})` : "Nachrichten", "/nachrichten"],
            ["freunde", "Freunde", "/freunde"],
            ["auszeichnungen", "Auszeichnungen", "/auszeichnungen"],
          ];
        %>
        <a href="/uebersicht" class="<%= a === 'uebersicht' ? 'on' : '' %>">Übersicht</a>
        <details class="menu" <%= aktionen.some(([k]) => k === a) ? 'open' : '' %>>
          <summary class="<%= aktionen.some(([k]) => k === a) ? 'on' : '' %>">Aktionen</summary>
          <div class="dropdown">
            <% for (const [key, label, href] of aktionen) { %>
              <a href="<%= href %>" class="<%= a === key ? 'on' : '' %>"><%= label %></a>
            <% } %>
          </div>
        </details>
        <a href="/weiterbildung" class="<%= a === 'weiterbildung' ? 'on' : '' %>">Weiterbildung</a>
        <a href="/stadt" class="<%= a === 'stadt' ? 'on' : '' %>">Stadt</a>
        <a href="/inventar" class="<%= a === 'inventar' ? 'on' : '' %>">Inventar</a>
        <a href="/kampf" class="<%= a === 'kampf' ? 'on' : '' %>">Kampf</a>
        <a href="/bande" class="<%= a === 'bande' ? 'on' : '' %>">Bande</a>
        <details class="menu" <%= community.some(([k]) => k === a) ? 'open' : '' %>>
          <summary class="<%= community.some(([k]) => k === a) ? 'on' : '' %> <%= unread > 0 ? 'attention' : '' %>">Community<%= unread > 0 ? ' ✉️' : '' %></summary>
          <div class="dropdown">
            <% for (const [key, label, href] of community) { %>
              <a href="<%= href %>" class="<%= a === key ? 'on' : '' %>"><%= label %></a>
            <% } %>
          </div>
        </details>
        <a href="/einstellungen" class="<%= a === 'einstellungen' ? 'on' : '' %>" title="Einstellungen">⚙️</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="linklike" type="submit" title="Abmelden">Abmelden</button>
        </form>
      </nav>
    <% } else { %>
      <nav class="nav">
        <a href="/login">Anmelden</a>
        <a href="/registrieren">Registrieren</a>
      </nav>
    <% } %>
  </div>
  <% if (locals.user && locals.status) { %>
    <div class="statusbar">
      <span class="chip" title="Bargeld / Behälter-Kapazität">💶 <%= fmtMoney(status.money) %> <span class="muted">/ <%= fmtMoney(status.capacity) %></span></span>
      <span class="chip" title="Pfandflaschen im Beutel · Tageskurs">🍾 <%= status.bottles %> <span class="muted">(Kurs <%= status.kurs %> ct)</span></span>
      <span class="chip" title="Angriff (inkl. Waffe)">⚔️ <%= status.att %></span>
      <span class="chip" title="Verteidigung">🛡️ <%= status.def %></span>
      <span class="chip" title="Geschicklichkeit">✋ <%= status.geschick %></span>
      <span class="chip" title="Sauberkeit">🧼 <%= status.cleanliness %> %</span>
      <span class="chip" title="Promillepegel — Laune: <%= status.mood %>">🍺 <%= status.promilleLabel %></span>
      <span class="chip" title="Punkte und Highscore-Rang">🏆 <%= status.points %> Pkt. <span class="muted">· Rang <%= status.rank %></span></span>
      <% if (status.onVacation) { %>
        <span class="chip vacation" title="Urlaubsmodus: unangreifbar, halbes Nebeneinkommen">🏖️ Urlaub bis <%= fmtDateTime(status.vacationUntil) %></span>
      <% } %>
    </div>
  <% } %>
</header>
<main class="wrap">
<% for (const f of (locals.flashes || [])) { %>
  <div class="flash <%= f.type %>"><%= f.msg %></div>
<% } %>
