<%- include('partials/head', { title, active }) %>
<h1>Inventar</h1>

<div class="grid-2">
  <section class="card">
    <h2>Geldbeutel</h2>
    <p>
      <strong><%= fmtMoney(user.money) %></strong>
      <span class="muted">von <%= fmtMoney(stats.capacity) %> Kapazität</span>
    </p>
    <div class="bar"><div class="bar-fill" style="width: <%= Math.min(100, Math.round(user.money / stats.capacity * 100)) %>%"></div></div>
    <p class="muted small">
      Aktiver Behälter: <strong><%= stats.container ? stats.container.name : 'Hosentasche' %></strong>
      (<a href="/stadt/zubehoer">größere gibt’s im Zubehörladen</a>).
      Alles, was nicht reinpasst, geht verloren.
    </p>
  </section>

  <section class="card">
    <h2>Pfandflaschen</h2>
    <p><strong><%= user.bottles %></strong> Flaschen im Beutel · Tageskurs <strong><%= kurs %> Cent</strong></p>
    <% if (user.bottles > 0) { %>
      <p class="muted">Verkaufswert heute: <strong><%= fmtMoney(bottleProceeds) %></strong></p>
      <% if (user.money + bottleProceeds > stats.capacity) { %>
        <p class="flash err">Achtung: Das passt nicht komplett in deinen Behälter —
          <%= fmtMoney(user.money + bottleProceeds - stats.capacity) %> würden verloren gehen!</p>
      <% } %>
      <form method="post" action="/inventar/verkaufen">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-primary" type="submit">Alle verkaufen</button>
      </form>
    <% } else { %>
      <p class="muted">Nichts im Beutel. <a href="/aktionen/sammeln">Geh eine Runde sammeln.</a></p>
    <% } %>
  </section>
</div>

<section class="card">
  <h2>Ausrüstung</h2>
  <% if (equipment.length === 0) { %>
    <p class="muted">Du besitzt genau: nichts. <a href="/stadt">Die Läden der Stadt</a> helfen dir auf die Beine.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Gegenstand</th><th>Effekt</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% for (const o of equipment) { %>
            <tr>
              <td><strong><%= o.name %></strong> <span class="muted">(Stufe <%= o.tier %>)</span></td>
              <td class="muted"><%= o.effectText %></td>
              <td>
                <% if (o.isActive) { %>
                  <span class="badge on">aktiv</span>
                <% } else { %>
                  <form method="post" action="/inventar/aktivieren" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="invId" value="<%= o.invId %>">
                    <button class="btn btn-sm" type="submit">Aktivieren</button>
                  </form>
                <% } %>
              </td>
              <td>
                <form method="post" action="/inventar/verkaufen-item" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="invId" value="<%= o.invId %>">
                  <button class="btn btn-sm btn-danger" type="submit">Verkaufen (<%= fmtMoney(o.resale) %>)</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <h2>Proviant</h2>
  <p class="muted">
    Dein Pegel: <strong><%= promilleLabel %></strong> · Laune: <%= mood %>.
    Trinken hebt den Pegel (gut fürs Training), Essen senkt ihn (gut vorm Kampf).
  </p>
  <% if (consumables.length === 0) { %>
    <p class="muted">Nichts zu beißen dabei. <a href="/stadt/supermarkt">Ab in den Supermarkt.</a></p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Vorrat</th><th>Wirkung</th><th>Menge</th><th></th></tr></thead>
        <tbody>
          <% for (const o of consumables) { %>
            <tr>
              <td><strong><%= o.name %></strong></td>
              <td class="muted"><%= o.effectText %></td>
              <td><%= o.quantity %>×</td>
              <td>
                <form method="post" action="/inventar/konsumieren" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="invId" value="<%= o.invId %>">
                  <button class="btn btn-sm btn-primary" type="submit"><%= o.category === 'drink' ? 'Trinken' : 'Essen' %></button>
                </form>
                <form method="post" action="/inventar/verkaufen-item" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="invId" value="<%= o.invId %>">
                  <button class="btn btn-sm" type="submit">Verkaufen (<%= fmtMoney(o.resale) %>)</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('partials/foot') %>
